%% Предпроцессинг транзакций POS -> Processing. Общая схема.
%% Файл содержит только Mermaid: вставьте его целиком в https://mermaid.live
%% Пояснения: ../preprocessing-architecture-notes.md. Схемы по слоям: соседние *.mmd
%% Обратный путь (шаги 6, 7, 8) нарисован линией без стрелки, направление показывает знак ◀ в подписи.
flowchart LR
    subgraph L1["1 · Терминалы (вне ЦОД)"]
        direction TB
        POS(["<b>POS-терминалы</b> ×100 000<br/>ISO 8583, TCP + TLS"])
        DNS["DNS<br/>имя входа → адрес"]
        TMS["Сервер настроек TMS<br/>таймауты, адреса, эхо"]
    end

    RT["<b>2 · Маршрутизаторы L3</b> ×2<br/>BGP, ECMP по потоку<br/>соединений не помнят<br/>пакеты в обе стороны"]
    GW["<b>3 · ISO-Gateway</b> ×8<br/>TLS, сокеты, connectionId<br/>F41 → кольцо → блок<br/>сам отвечает на эхо 0800"]

    subgraph BLOCK["4–5 · Блок b5 — один из 6: одно приложение в трёх ролях (Kubernetes) и своя БД"]
        direction TB
        subgraph RQ["Роль Request — путь запроса"]
            direction TB
            TR["<b>Transaction Receiver</b><br/>проверки, MAC,<br/>ключ идемпотентности"]
            PS["<b>Processing Sender</b><br/>Submit, лимит,<br/>предохранитель, выбор A / B"]
            DLR["<b>Delivery</b> (библиотека)<br/>доставка сохранённого ответа"]
        end
        subgraph RS["Роль Response — путь ответа"]
            direction TB
            RR["<b>Result Receiver</b><br/>приём результата"]
            DLV["<b>Delivery</b><br/>подпись и доставка ответа"]
        end
        TM["<b>Роль Timeout Monitor</b><br/>сроки, GetStatus,<br/>автореверсы"]
        subgraph DBL["5 · БД блока (серверы вне Kubernetes)"]
            direction TB
            PG[("<b>PostgreSQL b5</b><br/>primary + 2 синхронные реплики<br/>(достаточно подтверждения 1 из 2)")]
            PAT["<b>Patroni</b> — агент на каждом<br/>из 3 серверов БД:<br/>кто primary, promote<br/>(реплика → primary), sync-реплики"]
            DCS[("<b>etcd блока</b> ×3 (DCS)<br/>ключ лидера с TTL")]
        end
    end

    HSM["<b>6 · HSM</b> ×7<br/>MAC, PIN, ключи"]
    CR["<b>8 · Callback Router</b> ×4<br/>/v1/blocks/b5/result → блок"]

    subgraph L9["9 · Процессинг (чёрный ящик)"]
        direction TB
        PA["<b>Процессинг A</b>"]
        PB["<b>Процессинг B</b>"]
    end

    subgraph SI["Стендины SI1, SI2"]
        direction TB
        SIAPP["Приложения стендина<br/>прогреты, без трафика"]
        SIPG[("6 отдельных standby-кластеров<br/>b1 … b6, только чтение<br/>до promote — команды<br/>«стать рабочей базой»")]
        SIPAT["Patroni стендина<br/>(режим standby_cluster)"]
        SIDCS[("etcd стендина ×3")]
    end

    subgraph CTL["Управление (вне пути транзакции)"]
        direction TB
        RC[("<b>etcd маршрутизации</b> ×5, Raft<br/>(Routing Config)<br/>кольцо, карта блоков,<br/>правила A / B, номер версии")]
        FO["<b>Оркестратор переключения блоков</b> ×2<br/>следит за жизнью блоков,<br/>решает по большинству,<br/>изолирует блок, делает promote<br/>копии в стендине,<br/>пишет новую карту"]
        ADM["Инженер через конвейер<br/>кольцо, правила, миграция"]
    end

    subgraph L7["7 · Аудит и наблюдение"]
        direction TB
        AUD[["<b>Аудит</b><br/>Kafka → ClickHouse + WORM"]]
        MON["Логи, метрики, алерты"]
    end

    %% путь транзакции
    POS ==>|"① 0200 Покупка"| RT
    RT ==>|"хеш соединения"| GW
    GW ==>|"② accept + connectionId"| TR
    TR ==>|"③ поиск по ключу<br/>или запись RECEIVED"| PG
    TR ==>|"новая операция"| PS
    TR -->|"повтор, ответ уже в БД<br/>вызов внутри Request"| DLR
    GW ---|"◀ сохранённый ответ<br/>по connectionId повтора"| DLR
    PS ==>|"④ Submit → ACCEPTED"| PA
    PS -.->|"если A недоступен"| PB
    PA -.->|"⑤ Result"| CR
    PB -.-> CR
    RR ===|"◀ ⑥ в блок-владелец"| CR
    RR ==>|"запись итога"| PG
    RR ==> DLV
    GW ===|"◀ ⑦ deliver(connectionId)"| DLV
    RT ===|"◀ ⑧ 0210 Ответ на покупку<br/>(итог в F39)"| GW
    POS ===|"◀ ⑧"| RT

    %% сроки и отмены
    TM --- PG
    TM -.->|"GetStatus, Reverse"| PA

    %% безопасность
    TR -->|"MAC, PIN"| HSM
    DLV -->|"MAC ответа"| HSM

    %% БД блока: Patroni и его DCS
    PAT ---|"управляет"| PG
    PAT <-->|"ключ лидера, продление каждые 10 с"| DCS
    SIPAT --- SIPG
    SIPAT <--> SIDCS

    %% резерв и аудит
    PG -.->|"асинхронная репликация<br/>(каскадом с реплики)"| SIPG
    SIAPP --- SIPG
    PG -.->|"поток изменений"| AUD

    %% управление: настройки маршрутов
    RC -.->|"подписка (watch):<br/>кольцо, карта блоков"| GW
    RC -.->|"подписка: карта блоков"| CR
    FO -->|"запись: карта блоков"| RC
    ADM -->|"запись с проверкой"| RC

    %% управление: наблюдение за блоком и перевод
    FO -.->|"проба 1: /ready роли Request"| TR
    FO -.->|"проба 2: Patroni REST API"| PAT
    FO -.->|"вопрос: «видишь b5?»"| GW
    FO -.->|"вопрос: «видишь b5?»"| CR
    FO -->|"изоляция: firewall, IPMI"| BLOCK
    FO -->|"promote: копия b5 →<br/>рабочая база"| SIPAT

    %% настройки терминала
    POS -.-> DNS
    POS -.-> TMS

    classDef pos fill:#eef2f7,stroke:#5b6b7f,color:#1a1a1a
    classDef edge fill:#e8f4ea,stroke:#4f8a5b,color:#1a1a1a
    classDef blk fill:#e7effa,stroke:#4a6fa5,color:#1a1a1a
    classDef db fill:#f1eaf7,stroke:#7c5aa0,color:#1a1a1a
    classDef hsm fill:#fbe9e7,stroke:#b0524b,color:#1a1a1a
    classDef obs fill:#fff3dc,stroke:#b8860b,color:#1a1a1a
    classDef proc fill:#eeeeee,stroke:#555555,color:#1a1a1a
    classDef ctl fill:#fff8e1,stroke:#b8860b,color:#1a1a1a
    classDef etcd fill:#ffe9a8,stroke:#b8860b,stroke-width:3px,color:#1a1a1a
    classDef infra fill:#f6f0fb,stroke:#7c5aa0,stroke-dasharray:3 3,color:#1a1a1a
    class POS,DNS,TMS pos
    class RT,GW,CR edge
    class TR,PS,DLR,RR,DLV,TM,SIAPP blk
    class PG,SIPG db
    class PAT,SIPAT,DCS,SIDCS infra
    class HSM hsm
    class AUD,MON obs
    class PA,PB proc
    class FO,ADM ctl
    class RC etcd
    style BLOCK fill:#f5f8fd,stroke:#4a6fa5,stroke-width:2px
    style RQ fill:#ffffff,stroke:#4a6fa5,stroke-dasharray:4 3
    style RS fill:#ffffff,stroke:#4a6fa5,stroke-dasharray:4 3
    style DBL fill:#fbf8fe,stroke:#7c5aa0,stroke-dasharray:4 3
    style CTL fill:#fffcf0,stroke:#b8860b,stroke-dasharray:5 5
    style SI fill:#f5f8fd,stroke:#4a6fa5,stroke-dasharray:5 5
