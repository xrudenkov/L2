%% Слои 1-3: как терминал попадает в систему. Только Mermaid, вставляется в mermaid.live целиком.
flowchart LR
    subgraph L1["1 · Терминал (вне ЦОД)"]
        direction TB
        POS(["<b>POS-терминал</b><br/>одно постоянное соединение<br/>эхо 0800 раз в 60 с простоя"])
        DNS["<b>DNS</b><br/>имя входа → VIP"]
        TMS["<b>Сервер настроек TMS</b><br/>адреса, таймауты, период эхо,<br/>правила переподключения"]
    end

    subgraph L2["2 · Маршрутизаторы L3"]
        direction TB
        RT1["<b>Маршрутизатор 1</b>"]
        RT2["<b>Маршрутизатор 2</b>"]
    end

    subgraph L3["3 · ISO-Gateway ×8 (серверы вне Kubernetes)"]
        direction TB
        GW1["<b>gw-01</b><br/>Netty + FRR + Health Agent"]
        GW2["<b>gw-02 … gw-07</b>"]
        GW8["<b>gw-08</b>"]
    end

    BLOCK["<b>Блок терминала</b><br/>выбран по F41"]
    RC["<b>Routing Config</b><br/>кольцо, карта блоков"]

    POS -.->|"при включении"| DNS
    POS -.->|"при включении и раз в сутки"| TMS
    POS ==>|"TCP + TLS, ISO 8583"| RT1
    POS ==> RT2
    RT1 ==>|"ECMP: хеш соединения → шлюз"| GW1
    RT1 ==> GW2
    RT2 ==> GW2
    RT2 ==> GW8
    GW1 -.->|"BGP: анонс VIP"| RT1
    GW1 ==>|"accept(iso, connectionId)"| BLOCK
    GW2 ==> BLOCK
    GW8 ==> BLOCK
    BLOCK ==>|"deliver(connectionId) — на шлюз из connectionId"| GW1
    GW1 ===|"◀ 0210 ответ: обратно через маршрутизатор"| RT1
    RT1 ===|"◀"| POS
    RC -.->|"настройки по версиям"| GW2

    classDef pos fill:#eef2f7,stroke:#5b6b7f,color:#1a1a1a
    classDef edge fill:#e8f4ea,stroke:#4f8a5b,color:#1a1a1a
    classDef blk fill:#e7effa,stroke:#4a6fa5,color:#1a1a1a
    classDef db fill:#f1eaf7,stroke:#7c5aa0,color:#1a1a1a
    classDef hsm fill:#fbe9e7,stroke:#b0524b,color:#1a1a1a
    classDef obs fill:#fff3dc,stroke:#b8860b,color:#1a1a1a
    classDef proc fill:#eeeeee,stroke:#555555,color:#1a1a1a
    classDef ctl fill:#fff8e1,stroke:#b8860b,color:#1a1a1a
    class POS,DNS,TMS pos
    class RT1,RT2,GW1,GW2,GW8 edge
    class BLOCK blk
    class RC ctl
